# Copia este archivo como .env y completa OMLX_API_KEY (nunca subas .env a GitHub)
OMLX_API_KEY=
OMLX_URL=http://127.0.0.1:8000
# Servidor del asistente (lo publica el túnel) y página de gestión (solo este Mac; 0 = desactivada)
PORT=5204
ADMIN_PORT=5205
# Dirección de Cloudflare donde se publica el widget (publicar.sh espera a que muestre el túnel nuevo)
SITIO_URL=https://asistente-ia.faenabot.stream
MAX_TOKENS=1024
MAX_CONCURRENT=2
RATE_PER_MIN=20
SOLICITUDES_PER_MIN=5

# Túnel fijo (opcional): túnel con nombre de Cloudflare con dirección propia. Sin estas líneas, publicar.sh abre
# un túnel gratuito (trycloudflare) cuya dirección cambia en cada arranque.
#   cloudflared tunnel login && cloudflared tunnel create faenabot
#   cloudflared tunnel route dns faenabot api.ejemplo.com   (y gestion.ejemplo.com si se publica la gestión)
# TUNEL_CONFIG=~/.cloudflared/faenabot.yml
# TUNEL_URL=https://api.ejemplo.com

# Gestión desde internet (opcional): solo con Cloudflare Access. Sin ACCESS_TEAM y ACCESS_AUD queda solo en este Mac.
# GESTION_HOST=gestion.ejemplo.com
# ACCESS_TEAM=nombre-del-equipo        (el de nombre-del-equipo.cloudflareaccess.com)
# ACCESS_AUD=                          (Application Audience Tag de la aplicación de Access)
